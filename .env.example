PORT=8080
DATABASE_URL=postgres://senvalise:senvalise@postgres:5432/senvalise?sslmode=disable

# Obligatoire. Une chaine longue et aleatoire, propre a l'installation.
# En production (APP_ENV=production) le serveur refuse de demarrer si cette
# variable est absente ou laissee a une valeur par defaut connue.
JWT_SECRET=change-me-in-production

# Passe a "production" pour durcir le demarrage.
APP_ENV=development

ADMIN_EMAIL=gerant@senvalise.sn
ADMIN_PASSWORD=ChangeMe123!

# Jeu de demonstration. A laisser vide ou "false" sur une vraie installation.
SEED_DEMO=false

APP_ORIGIN=http://localhost:3000
